# =======================================================
# Transporte y Logística Andina S.R.L. - Variables de Entorno
# =======================================================

# Base de Datos (PostgreSQL en Docker - puerto 5433 para evitar colisión con postgres local de Windows)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=logistica_andina
DB_USER=postgres
DB_PASSWORD=postgres

# API Gateway
GATEWAY_PORT=3000
FRONTEND_URL=http://localhost:5173

# Microservicios (Puertos locales)
ENVIOS_SERVICE_PORT=3001
FLOTA_SERVICE_PORT=3002
CONDUCTORES_SERVICE_PORT=3003
ENTREGAS_SERVICE_PORT=3004

# URLs internas para Gateway y comunicación entre servicios
ENVIOS_SERVICE_URL=http://localhost:3001
FLOTA_SERVICE_URL=http://localhost:3002
CONDUCTORES_SERVICE_URL=http://localhost:3003
ENTREGAS_SERVICE_URL=http://localhost:3004

# Frontend Vite
VITE_API_URL=http://localhost:3000/api/v1
